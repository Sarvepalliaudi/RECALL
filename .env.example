# ==============================================================================
# RECALL Environment Configuration
# ==============================================================================

# Core Settings
ENVIRONMENT=development
APP_NAME=RECALL
APP_TAGLINE="Your devices remember files. RECALL remembers meaning."
HOST=127.0.0.1
PORT=8000
FRONTEND_URL=http://localhost:3000

# Security & Sessions
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-secure-random-64-character-hex-string
SESSION_COOKIE_NAME=recall_session
SESSION_EXPIRE_HOURS=72
SECURE_COOKIES=false # Set to true in production with HTTPS
ALGORITHM=HS256

# Database & Vector Store
# Production / Full setup: postgresql+asyncpg://user:password@localhost:5432/recall
# Standalone local dev fallback: sqlite+aiosqlite:///./recall_local.db
DATABASE_URL=sqlite+aiosqlite:///./recall_local.db
USE_PGVECTOR=false # Set to true when connecting to PostgreSQL with pgvector

# Google GenAI / Gemini API
# Required for embeddings (text-embedding-004) and contextual query rationale
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_REASONING_MODEL=gemini-3.8-flash

# Storage & Vault Paths
LOCAL_VAULT_PATH=./storage/vault
MAX_UPLOAD_SIZE_MB=50

# OCR Settings
TESSERACT_CMD= # Optional: C:\Program Files\Tesseract-OCR\tesseract.exe
ENABLE_OCR=true
